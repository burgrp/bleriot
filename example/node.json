{
    "node": "heating-controller",
    "metadata": {
        "hw_rev": "1.3"
    },
    "classes": {
        "thermometer": {
            "registers": {
                "temperature": {
                    "type": "float",
                    "multiplier": 1,
                    "divider": 100,
                    "metadata": {
                        "unit": "°C"
                    }
                },
                "humidity": {
                    "type": "int",
                    "multiplier": 1,
                    "divider": 1,
                    "metadata": {
                        "unit": "%"
                    }
                }
            }
        },
        "switch": {
            "registers": {
                "state": {
                    "type": "bool"
                }
            }
        }
    },
    "instances": {
        "sensor": "thermometer",
        "heating": "switch",
        "led": "switch"
    }
}